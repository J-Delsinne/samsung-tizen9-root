# === Secrets and credentials (NEVER commit) ===
*.key
*.pem
id_rsa*
id_ed25519*
id_ecdsa*
authorized_keys
known_hosts
*.p12
*.pfx
.env
.env.*
secrets/
credentials/

# === Extracted key material (legal risk) ===
# HDCP keys, DRM keys, TEE keys, device-bound secrets
hdcp_key_*.bin
hdcp_keyset_*.bin
hdcp_*.bin
drm_*.bin
tee_key_*.bin
device_key_*.bin
captured_keys/
extracted_keys/
keys-wrapped/

# === Samsung firmware binaries (copyright) ===
# Do not redistribute Samsung's compiled code
*.tee
58D50001*
*TA*.bin
libtzcapturec*.so
libvideo-capture*.so
libdisplay-capture-api*.so
libhwcrypto*.so
libcryptocore*.so
MultiControlService.dll
MultiControlService.dll.*
*.dll.backup*

# === Device-specific captured data ===
